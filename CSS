*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#f9fff8;
color:#1b4332;
overflow-x:hidden;
}

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 8%;
background:#ffffff;
position:fixed;
top:0;
width:100%;
box-shadow:0 5px 20px rgba(0,0,0,.08);
z-index:999;
}

.logo h1{
color:#2E7D32;
font-size:34px;
font-weight:700;
letter-spacing:1px;
}

nav a{
text-decoration:none;
margin-left:35px;
font-weight:500;
color:#1b4332;
transition:.3s;
}

nav a:hover{
color:#8BC34A;
}

.hero{
min-height:100vh;
display:flex;
justify-content:space-between;
align-items:center;
padding:120px 8%;
background:linear-gradient(135deg,#f6fff2,#ffffff);
}

.hero-text{
width:50%;
}

.hero-text h4{
color:#8BC34A;
font-size:22px;
margin-bottom:15px;
}

.hero-text h1{
font-size:65px;
line-height:80px;
margin-bottom:20px;
}

.hero-text p{
font-size:22px;
margin-bottom:40px;
color:#555;
}

.btn{
display:inline-block;
padding:16px 42px;
background:#2E7D32;
color:white;
text-decoration:none;
border-radius:50px;
font-weight:600;
transition:.4s;
}

.btn:hover{
background:#8BC34A;
transform:translateY(-5px);
}

.hero-image{
width:45%;
text-align:center;
}

.hero-image img{
width:90%;
animation:float 4s ease-in-out infinite;
}

@keyframes float{

0%{
transform:translateY(0);
}

50%{
transform:translateY(-20px);
}

100%{
transform:translateY(0);
}

}

.features{
display:flex;
justify-content:center;
gap:30px;
padding:80px 8%;
flex-wrap:wrap;
}

.box{
background:white;
padding:35px;
width:300px;
border-radius:20px;
box-shadow:0 10px 25px rgba(0,0,0,.08);
transition:.4s;
text-align:center;
}

.box:hover{
transform:translateY(-12px);
}

footer{
background:#1b4332;
color:white;
padding:25px;
text-align:center;
}

@media(max-width:768px){

header{
flex-direction:column;
}

nav{
margin-top:15px;
}

.hero{
flex-direction:column-reverse;
text-align:center;
}

.hero-text{
width:100%;
}

.hero-image{
width:100%;
margin-bottom:40px;
}

.hero-text h1{
font-size:45px;
line-height:55px;
}

.features{
padding:50px 20px;
}

}
.countdown{
margin-top:25px;
font-size:28px;
font-weight:bold;
color:#2E7D32;
}
/* WhatsApp */

.whatsapp{

position:fixed;

right:25px;

bottom:25px;

width:65px;

height:65px;

background:#25D366;

border-radius:50%;

display:flex;

justify-content:center;

align-items:center;

font-size:30px;

color:white;

text-decoration:none;

box-shadow:0 8px 20px rgba(0,0,0,.3);

transition:.4s;

z-index:999;

}

.whatsapp:hover{

transform:scale(1.1);

}
